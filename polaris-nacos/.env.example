# 复制本文件为 polaris-nacos/.env 并填入真实值；该文件已被 .gitignore 忽略。
#
# 使用部署方受控的密钥工具生成 32 字节随机密钥，Base64 编码后填入 SSO_CONF_KEY。
# 敏感配置使用与 SecretCipher 兼容的 AES-256-GCM 格式加密为 ENC(...)，
# 再写入 polaris-nacos/config/<env>/*.yaml；真实密钥和明文不得写入示例文件。
#
# 注意：主密钥一旦用于加密，就不能随意更换——换了以后所有 ENC(...) 都解不开，
#       服务会在启动时报「配置解密失败」并中止。轮换密钥的正确做法是：
#       用新密钥重新加密全部密文，一次性一起推上去。
SSO_CONF_KEY=

# 可选：主密钥也可以放文件（容器里挂 secret 更合适），优先级低于上面的变量
# SSO_CONF_KEY_FILE=/run/secrets/sso_conf_key

# Nacos 连接信息；账号密码只用于读取配置，不下发到业务配置中。
SSO_NACOS_ENABLED=true
SSO_NACOS_ADDR=127.0.0.1:18848
SSO_NACOS_USER=nacos
SSO_NACOS_PASSWORD=
SSO_NACOS_NAMESPACE=sso-ms-local
SSO_NACOS_GROUP=SSO
SSO_NACOS_DISCOVERY=false

# 与线上一致：数据库 URL、JWT 文件路径等非 Nacos 项仍由本地环境提供。
SSO_DB_URL=jdbc:mysql://127.0.0.1:3306/sso_ms?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SSO_SQL_INIT_MODE=always
FORUM_DB_URL=jdbc:mysql://127.0.0.1:3306/forum?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
FORUM_SQL_INIT_MODE=always
# 不使用 Nacos 下发论坛密钥时，才取消注释并在本地私密 .env 中填写
# FORUM_APP_SECRET=
# FORUM_ADMIN_APP_SECRET=
SSO_JWT_PRIVATE_KEY=file:F:/code/sso/tmp/repo/polaris-server/polaris-nacos/.secrets/jwt-private.pem
SSO_JWT_PUBLIC_KEY=file:F:/code/sso/tmp/repo/polaris-server/polaris-nacos/.secrets/jwt-public.pem
