# ================= 域名 =================
DOMAIN=laimengchao.site
# 部署脚本用：服务器地址与 SSH 用户
SERVER_HOST=1.2.3.4
SERVER_USER=root

# ================= MySQL =================
# 建议单独建账号 polaris，只授权 6 个业务库（见 sql/01-init.sql）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=polaris
MYSQL_PASSWORD=CHANGE_ME

SSO_DB_URL=jdbc:mysql://127.0.0.1:3306/sso_ms?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SSO_DB_USER=polaris
SSO_DB_PASSWORD=CHANGE_ME

SETTINGS_DB_URL=jdbc:mysql://127.0.0.1:3306/settings?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SETTINGS_DB_USER=polaris
SETTINGS_DB_PASSWORD=CHANGE_ME

EHR_DB_URL=jdbc:mysql://127.0.0.1:3306/ehr?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
EHR_DB_USER=polaris
EHR_DB_PASSWORD=CHANGE_ME

CMS_DB_URL=jdbc:mysql://127.0.0.1:3306/cms?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
CMS_DB_USER=polaris
CMS_DB_PASSWORD=CHANGE_ME

BLOG_DB_URL=jdbc:mysql://127.0.0.1:3306/blog?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
BLOG_DB_USER=polaris
BLOG_DB_PASSWORD=CHANGE_ME

JOB_DB_URL=jdbc:mysql://127.0.0.1:3306/polaris_job?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
JOB_DB_USER=polaris
JOB_DB_PASSWORD=CHANGE_ME

# ================= Redis（auth 的令牌吊销名单） =================
SSO_REDIS_HOST=127.0.0.1
SSO_REDIS_PORT=6379
SSO_REDIS_DB=2
SSO_REVOCATION_STORE=redis

# ================= JWT 密钥与服务间令牌 =================
# 密钥不进镜像：把 polaris-server/polaris-nacos/.secrets/prod-jwt-private.pem
# 和 prod-jwt-public.pem 拷到服务器 /opt/polaris/keys/，容器内挂到 /app/keys
# （不建议生产复用 jwt-private.pem 那对开发密钥）
SSO_JWT_PRIVATE_KEY=file:/app/keys/prod-jwt-private.pem
SSO_JWT_PUBLIC_KEY=file:/app/keys/prod-jwt-public.pem
# 生成：openssl rand -hex 32
SSO_INTERNAL_TOKEN=CHANGE_ME_64_RANDOM_HEX

# ================= 各应用 app_secret（必须与 sso_application.app_secret 一致） =================
EHR_APP_SECRET=ssBKd8C2ko8QxCMTgbxiYiZjLPkKbisx
CMS_APP_SECRET=rhD2coJ5zr2srMarnxfc9fJdexKPMVgo
BLOG_APP_SECRET=kvEwn3hmYjjWmqpsDHaSivza59AzgUxc
SETTINGS_APP_SECRET=i7kN2dvTDSXVKAALeMLzNwdwEePVUpag
JOB_APP_SECRET=jObS3cr3tX9Kw7dN2pQ5vYzLmAeRuTc8H

# ================= 服务间地址（host 网络下都是回环） =================
SSO_AUTH_URL=http://127.0.0.1:9001
SSO_ACCOUNT_URL=http://127.0.0.1:9002
SETTINGS_URL=http://127.0.0.1:9007
EHR_URL=http://127.0.0.1:9006
JOB_CENTER_URL=http://127.0.0.1:9008

# ================= 对外地址（已申请的域名） =================
# polaris-sso / polaris-ehr / polaris-settings / polaris-job / polaris-portal
# portal-blog-web / portal-blog-admin 是前端站点
# polaris-gateway / polaris-auth / polaris-account / portal-blog-api 是后端直连域名
EHR_WEB_URL=https://polaris-ehr.laimengchao.site
# CMS 没有独立前端域名，站点链接统一指向门户
CMS_SITE_BASE_URL=https://polaris-portal.laimengchao.site
CMS_PUBLIC_BASE_URL=http://127.0.0.1:9004/api/cms/public
PORTAL_SITE_BASE_URL=https://polaris-portal.laimengchao.site
BLOG_SITE_BASE_URL=https://portal-blog-web.laimengchao.site

# 上传目录：容器内路径，宿主机对应 ./uploads
BLOG_UPLOAD_ROOT=/app/uploads/blog

# ================= 首次启动建表（建完改回 never） =================
SSO_SQL_INIT_MODE=always
SETTINGS_SQL_INIT_MODE=always
EHR_SQL_INIT_MODE=always
CMS_SQL_INIT_MODE=always
JOB_SQL_INIT_MODE=always
BLOG_SQL_INIT_MODE=always
