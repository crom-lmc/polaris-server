# Polarís 生产环境变量模板：复制为 .env 后填入真实值，权限 600
DOMAIN=laimengchao.site

# ================= Nacos 配置中心 =================
# 数据库账号密码、各应用 app_secret、X-Internal-Token、Redis 密码统一由 Nacos 下发，
# 命名空间 sso-ms-prod、分组 SSO，dataId 为 {sso-auth,sso-account,sso-gateway,settings,ehr,cms,blog-admin,portal,job}.yaml
SSO_NACOS_ENABLED=true
SSO_NACOS_ADDR=172.17.0.1:8848
SSO_NACOS_USER=nacos
SSO_NACOS_PASSWORD=CHANGE_ME
SSO_NACOS_NAMESPACE=sso-ms-prod
SSO_NACOS_GROUP=SSO
SSO_NACOS_DISCOVERY=false

# ================= MySQL（仅地址与库名，账号密码在 Nacos） =================
SSO_DB_URL=jdbc:mysql://172.17.0.1:3306/sso_ms?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SETTINGS_DB_URL=jdbc:mysql://172.17.0.1:3306/settings?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
EHR_DB_URL=jdbc:mysql://172.17.0.1:3306/ehr?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
CMS_DB_URL=jdbc:mysql://172.17.0.1:3306/cms?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
BLOG_DB_URL=jdbc:mysql://172.17.0.1:3306/blog?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
JOB_DB_URL=jdbc:mysql://172.17.0.1:3306/polaris_job?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true

# ================= Redis =================
SSO_REDIS_HOST=127.0.0.1
SSO_REDIS_PORT=6379
SSO_REDIS_DB=2
SSO_REVOCATION_STORE=redis

# ================= JWT 密钥 =================
SSO_JWT_PRIVATE_KEY=file:/app/keys/prod-jwt-private.pem
SSO_JWT_PUBLIC_KEY=file:/app/keys/prod-jwt-public.pem

# ================= 服务间地址 =================
SSO_AUTH_URL=http://127.0.0.1:9001
SSO_ACCOUNT_URL=http://127.0.0.1:9002
SETTINGS_URL=http://127.0.0.1:9007
EHR_URL=http://127.0.0.1:9006
JOB_CENTER_URL=http://127.0.0.1:9008

# ================= 对外地址 =================
EHR_WEB_URL=https://polaris-ehr.${DOMAIN}
CMS_SITE_BASE_URL=https://polaris-portal.${DOMAIN}
CMS_PUBLIC_BASE_URL=http://127.0.0.1:9004/api/cms/public
PORTAL_SITE_BASE_URL=https://polaris-portal.${DOMAIN}
BLOG_SITE_BASE_URL=https://portal-blog-web.${DOMAIN}
BLOG_UPLOAD_ROOT=/app/uploads/blog
# CMS 媒体库与 EHR 附件目录：都落在宿主机 ./uploads 下，容器重建不丢文件
CMS_UPLOAD_ROOT=/app/uploads/cms
EHR_FILE_ROOT=/app/uploads/ehr

# ================= 建表开关（已有数据时保持 never） =================
SSO_SQL_INIT_MODE=never
SETTINGS_SQL_INIT_MODE=never
EHR_SQL_INIT_MODE=never
CMS_SQL_INIT_MODE=never
JOB_SQL_INIT_MODE=never
BLOG_SQL_INIT_MODE=never
