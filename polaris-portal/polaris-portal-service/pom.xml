<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.laimengchao.sso</groupId>
        <artifactId>polaris-server</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>polaris-portal-service</artifactId>
    <name>portal-service</name>
    <description>
        内容门户服务（端口 9005）：与 cms/blog-admin 同一套接入模板——
        认证消费网关注入的可信头（X-Account-*），单点换票由本服务持 PORTAL_APP_SECRET 完成。
        门户对外内容直接读 cms 的 /api/cms/public/**，本服务只负责登录态与后续扩展（评论等）。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.laimengchao.sso</groupId>
            <artifactId>polaris-common</artifactId>
        </dependency>

        <!-- 统一账号平台跨服客户端（AuthApi：单点换票） -->
        <dependency>
            <groupId>com.laimengchao.sso</groupId>
            <artifactId>polaris-sso-client</artifactId>
        </dependency>

        <!-- 配置中心客户端：聚合待办时调用 /internal/approval/pending -->
        <dependency>
            <groupId>com.laimengchao.sso</groupId>
            <artifactId>polaris-settings-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Nacos：默认关闭（SSO_NACOS_ENABLED=false），无 Nacos 时回退本文件配置 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>portal-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.laimengchao.sso.portal.PortalApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
